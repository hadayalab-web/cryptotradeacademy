# CryptoSignal AI - Environment Variables
# 本プロジェクトでは .env をコピーして使用すること: cp .env.example .env

# ============================================
# 基本設定
# ============================================
# 言語: en, es, pt-br, ar, ja, ko
LANG=en

# ============================================
# Cron 設定
# ============================================
# Vercel Cron ジョブ認証トークン
CRON_SECRET=your-cron-secret-token
# cron が /api/kiba/run を叩くときのベース URL（未設定時は VERCEL_URL を使用）。ローカルで scripts/verify-x-api-and-kiba-auth.js を動かすときは本番 URL を指定すると KIBA 認証を検証できる
# CRON_BASE_URL=https://your-app.vercel.app

# ============================================
# イベント駆動配信（Phase 1）
# ============================================
# 無効にする場合: ENABLE_EVENT_DRIVEN=false

# ============================================
# Gemini AI 設定
# ============================================
# Gemini API キー
GEMINI_API_KEY=your-gemini-api-key

# モデル（本番で変更する場合はここを編集）
GEMINI_QUOTE_REPOST_MODEL=gemini-3-pro-preview
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_CONTENT_OPTIMIZER_MODEL=gemini-3-pro-preview
# Gemini: CQ+過去比較でSoSoValue風記事（Regular配信）
# GEMINI_SOSOVALUE_MODEL=gemini-3-pro-preview

# ============================================
# Grok AI 設定
# ============================================
# Grok API キー
XAI_API_KEY=your-grok-api-key

# Grok API ベースURL（オプション）: https://api.x.ai/v1
# XAI_BASE_URL=https://api.x.ai/v1

# モデル（本番で変更する場合はここを編集）
GROK_MODEL_MARKET=grok-4-1-fast-reasoning
GROK_MODEL_MARKET_EMERGENCY=grok-4-1-fast-reasoning
GROK_MODEL_X_LIVE=grok-4-1-fast-reasoning
GROK_MODEL_HIGH_RES=grok-4-1-fast-reasoning
# 引用リポスト・リスト検索（Grok+Gemini→X API検証→KVストック）用
# GROK_MODEL_LIST_SEARCH=grok-4-1-fast-reasoning
# GEMINI_MODEL=gemini-3-pro-preview

# ============================================
# CryptoQuant API 設定
# ============================================
# CryptoQuant API キー
CRYPTOQUANT_API_KEY=your-cryptoquant-api-key

# ============================================
# Telegram 設定
# ============================================
# Bot トークン（有料版・無料版とも同じでよい）
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 旧仕様（1チャンネルだけのとき）。有料版は下の言語別を使う
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# 有料版（Regular Briefing / KIBA）配信先 — 言語ごとのチャンネルID（コードが参照する名前はこのとおり）
# TELEGRAM_CHAT_ID_BTC_EN=
# TELEGRAM_CHAT_ID_BTC_JA=
# TELEGRAM_CHAT_ID_BTC_ES=
# TELEGRAM_CHAT_ID_BTC_KO=
# TELEGRAM_CHAT_ID_BTC_PT_BR=
# TELEGRAM_CHAT_ID_BTC_AR=

# ============================================
# Vidalytics リンク（Trap Defence X Repost OS・12本）
# ============================================
VID_LINK_REGULAR_EN=https://preview.vidalytics.com/vid/R_qh_0xq5QcqNsT2
VID_LINK_MINIMAL_EN=https://preview.vidalytics.com/vid/r7EVEIvFx66Nj3dp

VID_LINK_REGULAR_ES=https://preview.vidalytics.com/vid/Sn0Ksfoqayhn19Hu
VID_LINK_MINIMAL_ES=https://preview.vidalytics.com/vid/C7qhJZh6N8reco2h

VID_LINK_REGULAR_PT_BR=https://preview.vidalytics.com/vid/4nFpiTEQLXbOruxk
VID_LINK_MINIMAL_PT_BR=https://preview.vidalytics.com/vid/0uqYb_5TWoSfBl6Y

VID_LINK_REGULAR_JA=https://preview.vidalytics.com/vid/ksCwzN2p2nOGUSso
VID_LINK_MINIMAL_JA=https://preview.vidalytics.com/vid/iQUVsxj5j522r_sf

VID_LINK_REGULAR_KO=https://preview.vidalytics.com/vid/7SP9FG5F9ox6PNYS
VID_LINK_MINIMAL_KO=https://preview.vidalytics.com/vid/OQNbnGJNtF6_W5zC

VID_LINK_REGULAR_AR=https://preview.vidalytics.com/vid/E3_5s_i7QfqcZnkm
VID_LINK_MINIMAL_AR=https://preview.vidalytics.com/vid/rBzQDrGv2xSyZKtK

# ============================================
# X (Twitter) API 設定
# ============================================
# X API Bearer Token（Search API /2/tweets/search/recent 専用・必須）
X_API_BEARER_TOKEN=your-x-api-bearer-token

# X API OAuth 1.0a 認証用（投稿・メトリクス取得）
X_API_CONSUMER_KEY=your-x-api-consumer-key
X_API_CONSUMER_KEY_SECRET=your-x-api-consumer-key-secret
X_API_ACCESS_TOKEN=your-x-api-access-token
X_API_ACCESS_TOKEN_SECRET=your-x-api-access-token-secret

# X API Webhook 署名検証用（X_API_CONSUMER_KEY_SECRET と同じ値を使用）
# X_API_CONSUMER_KEY_SECRET=your-x-api-consumer-key-secret

# ============================================
# Supabase（Trap Defence OS 実測パイプライン）
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# 接続先ズレ対策（Vercel 等で別プロジェクトに繋がる場合）:
# SUPABASE_PROJECT_REF=your-project-ref

# X API 投稿数上限設定（X API レート制限に基づく）
# X API レート制限: Per User 100/15min, Per App 10,000/24hrs
# X_MAX_DAILY_POSTS=250        # 1日の最大投稿数（デフォルト: 250）
# X_MAX_HOURLY_POSTS=100       # 1時間の最大投稿数（デフォルト: 100）

# ============================================
# OpenAI (GPT) 設定
# ============================================
# モデル（本番で変更する場合はここを編集）
GPT_MODEL_QUOTE_REPOST_OBJECTION=gpt-5-mini-2025-08-07

# 引用リポスト: Minimal/Regular 導線交互ローテーション（Grok×Gemini 分析統合）
# true にすると、インフルエンサーごとに「前回の導線」の逆を出す（初回は Minimal）
# QUOTE_REPOST_USE_MINIMAL_REGULAR_TEMPLATES=true

# ============================================
# 市場別設定
# ============================================
# 市場コード: EN, AR, KO, JA, ES, PT-BR
# LANG と連動する（個別指定は設定優先）
# MARKET_CODE=EN

# ============================================
# BuzzWeave PQT（引用リポスト・完全パターン化）
# ============================================
# 目標成約/日（Minimal+Regular合算）から日次投稿ターゲットを逆算（デフォルト有効）
# BUZZWEAVE_DAILY_CONVERSION_TARGET=100
# 1成約あたり投稿数の基準値（フェルミ初期値）
# BUZZWEAVE_BASE_POSTS_PER_CONVERSION=5
# 実測補正後の投稿/成約の下限・上限
# BUZZWEAVE_POSTS_PER_CONVERSION_MIN=2.5
# BUZZWEAVE_POSTS_PER_CONVERSION_MAX=12
# 実測補正の参照期間（日）
# BUZZWEAVE_DYNAMIC_LOOKBACK_DAYS=3
# 実測値を100%信頼するまでに必要な成約数（少ない時は基準値寄りに補正）
# BUZZWEAVE_DYNAMIC_FULL_TRUST_CONVERSIONS=20
# 動的目標を無効化する場合のみ false（true/未設定で有効）
# BUZZWEAVE_DYNAMIC_TARGET=true
# run cap 計算に使う 1日あたり run 数
# BUZZWEAVE_RUNS_PER_DAY_FOR_TARGET=6
# run あたり cap の上限（通常日）
# BUZZWEAVE_MAX_CAP_PER_RUN=100
# run あたり cap の上限（weekday warp 適用時）
# BUZZWEAVE_MAX_CAP_PER_RUN_WARP=200
# hard override（日次投稿ターゲット固定。設定時は最優先）
# BUZZWEAVE_DAILY_PQT_TARGET_HARD=600
# legacy 固定目標（動的目標を false にした時のみ使用）
# BUZZWEAVE_DAILY_PQT_TARGET=250
# 引用元の品質パターン: 本文がこの文字数未満は除外
# BUZZWEAVE_MIN_POST_LENGTH=20
# 引用元の URL がこの本数超は除外
# BUZZWEAVE_MAX_URLS_IN_POST=2
# 低会話投稿を除外（reply+retweet の下限）
# BUZZWEAVE_MIN_REPLY_RETWEET_SUM=0
# 低反応投稿を除外（like+reply+retweet+quote の下限）
# BUZZWEAVE_MIN_TOTAL_INTERACTIONS=0
# search/recent のクエリ分割サイズ（ORバケット）
# BUZZWEAVE_QUERY_BUCKET_SIZE=3
# 1バケットあたりのページ取得数（next_token）
# BUZZWEAVE_SEARCH_PAGES_PER_BUCKET=2
# クエリ文字数ガード（X API 512制限に余白を残す）
# BUZZWEAVE_SEARCH_QUERY_MAX_CHARS=480
# 低流量言語（例: ar）は 0件時に広い時間窓で再取得
# BUZZWEAVE_LOW_VOLUME_LANGS=ar
# 低流量言語で再取得する検索窓（分）
# BUZZWEAVE_LOW_VOLUME_SEARCH_WINDOW_MIN=30
# min_* 演算子は公式仕様の揺れがあるためデフォルトOFF
# BUZZWEAVE_USE_MIN_OPERATORS=false
# BUZZWEAVE_SEARCH_MIN_FAVES=20
# BUZZWEAVE_SEARCH_MIN_RETWEETS=5
# BUZZWEAVE_SEARCH_MIN_REPLIES=3
# 候補の露出優先スコア重み（合計は自動正規化）
# BUZZWEAVE_IMPRESSION_W_VELOCITY=0.4
# BUZZWEAVE_IMPRESSION_W_CONVERSATION=0.25
# BUZZWEAVE_IMPRESSION_W_REPOST=0.2
# BUZZWEAVE_IMPRESSION_W_FRESHNESS=0.15
# 同一作者の run 内採用上限
# BUZZWEAVE_MAX_SLOTS_PER_AUTHOR=1
# 同一クラスタの run 内上限比率（0.2〜1.0）
# BUZZWEAVE_MAX_CLUSTER_SHARE=0.4

# ============================================
# 環境設定
# ============================================
# 実行環境: development, production
NODE_ENV=production
# 【非推奨】NODE_TLS_REJECT_UNAUTHORIZED=0 は証明書検証を無効にし HTTPS が不安全になります。本番・Vercel では設定しないでください。

# ============================================
# Whop
# ============================================
# Whop REST API（プロモコード監視・商品取得・メンバーシップ等）
# WHOP_API_KEY=your-whop-api-key
# Whop の Company Webhook 署名検証用（ダッシュボードで発行）
# WHOP_WEBHOOK_SECRET=your-whop-webhook-secret
# WHOP_SKIP_SIGNATURE_FOR_TEST=1  # Whop Test webhook 用。テスト後は削除
# アフィリ ref 紐づけ用チェックアウト（/api/whop-checkout）。6言語×3プラン = 18個（Vercel にそのまま貼ってよい）
