# CryptoSignal AI - Environment Variables
# 本プロジェクトでは .env をコピーして使用すること: cp .env.example .env

# ============================================
# 基本設定
# ============================================
# 言語: en, es, pt-br, ar, ja, ko
LANG=en

# ============================================
# Cron 設定
# ============================================
# Vercel Cron ジョブ認証トークン
CRON_SECRET=your-cron-secret-token
# cron が /api/kiba/run を叩くときのベース URL（未設定時は VERCEL_URL を使用）。ローカルで scripts/verify-x-api-and-kiba-auth.js を動かすときは本番 URL を指定すると KIBA 認証を検証できる
# CRON_BASE_URL=https://your-app.vercel.app

# ============================================
# イベント駆動配信（Phase 1）
# ============================================
# 無効にする場合: ENABLE_EVENT_DRIVEN=false

# ============================================
# Gemini AI 設定
# ============================================
# Gemini API キー
GEMINI_API_KEY=your-gemini-api-key

# モデル（本番で変更する場合はここを編集）
GEMINI_QUOTE_REPOST_MODEL=gemini-3-pro-preview
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_CONTENT_OPTIMIZER_MODEL=gemini-3-pro-preview
# Gemini: CQ+過去比較でSoSoValue風記事（Regular配信）
# GEMINI_SOSOVALUE_MODEL=gemini-3-pro-preview

# ============================================
# Grok AI 設定
# ============================================
# Grok API キー
XAI_API_KEY=your-grok-api-key

# Grok API ベースURL（オプション）: https://api.x.ai/v1
# XAI_BASE_URL=https://api.x.ai/v1

# モデル（本番で変更する場合はここを編集）
GROK_MODEL_MARKET=grok-4-1-fast-reasoning
GROK_MODEL_MARKET_EMERGENCY=grok-4-1-fast-reasoning
GROK_MODEL_X_LIVE=grok-4-1-fast-reasoning
GROK_MODEL_HIGH_RES=grok-4-1-fast-reasoning
# 引用リポスト・リスト検索（Grok+Gemini→X API検証→KVストック）用
# GROK_MODEL_LIST_SEARCH=grok-4-1-fast-reasoning
# GEMINI_MODEL=gemini-3-pro-preview

# ============================================
# CryptoQuant API 設定
# ============================================
# CryptoQuant API キー
CRYPTOQUANT_API_KEY=your-cryptoquant-api-key

# ============================================
# Telegram 設定
# ============================================
# Telegram Bot トークン
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Telegram Chat ID
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================
# Vidalytics リンク（Trap Defence X Repost OS・12本）
# ============================================
VID_LINK_REGULAR_EN=https://preview.vidalytics.com/vid/R_qh_0xq5QcqNsT2
VID_LINK_MINIMAL_EN=https://preview.vidalytics.com/vid/r7EVEIvFx66Nj3dp

VID_LINK_REGULAR_ES=https://preview.vidalytics.com/vid/Sn0Ksfoqayhn19Hu
VID_LINK_MINIMAL_ES=https://preview.vidalytics.com/vid/C7qhJZh6N8reco2h

VID_LINK_REGULAR_PT_BR=https://preview.vidalytics.com/vid/4nFpiTEQLXbOruxk
VID_LINK_MINIMAL_PT_BR=https://preview.vidalytics.com/vid/0uqYb_5TWoSfBl6Y

VID_LINK_REGULAR_JA=https://preview.vidalytics.com/vid/ksCwzN2p2nOGUSso
VID_LINK_MINIMAL_JA=https://preview.vidalytics.com/vid/iQUVsxj5j522r_sf

VID_LINK_REGULAR_KO=https://preview.vidalytics.com/vid/7SP9FG5F9ox6PNYS
VID_LINK_MINIMAL_KO=https://preview.vidalytics.com/vid/OQNbnGJNtF6_W5zC

VID_LINK_REGULAR_AR=https://preview.vidalytics.com/vid/E3_5s_i7QfqcZnkm
VID_LINK_MINIMAL_AR=https://preview.vidalytics.com/vid/rBzQDrGv2xSyZKtK

# ============================================
# X (Twitter) API 設定
# ============================================
# X API Bearer Token（Search API /2/tweets/search/recent 専用・必須）
X_API_BEARER_TOKEN=your-x-api-bearer-token

# X API OAuth 1.0a 認証用（投稿・メトリクス取得）
X_API_CONSUMER_KEY=your-x-api-consumer-key
X_API_CONSUMER_KEY_SECRET=your-x-api-consumer-key-secret
X_API_ACCESS_TOKEN=your-x-api-access-token
X_API_ACCESS_TOKEN_SECRET=your-x-api-access-token-secret

# X API Webhook 署名検証用（X_API_CONSUMER_KEY_SECRET と同じ値を使用）
# X_API_CONSUMER_KEY_SECRET=your-x-api-consumer-key-secret

# ============================================
# Supabase（Trap Defence OS 実測パイプライン）
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# 接続先ズレ対策（Vercel 等で別プロジェクトに繋がる場合）:
# SUPABASE_PROJECT_REF=your-project-ref

# X API 投稿数上限設定（X API レート制限に基づく）
# X API レート制限: Per User 100/15min, Per App 10,000/24hrs
# X_MAX_DAILY_POSTS=250        # 1日の最大投稿数（デフォルト: 250）
# X_MAX_HOURLY_POSTS=100       # 1時間の最大投稿数（デフォルト: 100）

# ============================================
# OpenAI (GPT) 設定
# ============================================
# モデル（本番で変更する場合はここを編集）
GPT_MODEL_QUOTE_REPOST_OBJECTION=gpt-5-mini-2025-08-07

# 引用リポスト: Minimal/Regular 導線交互ローテーション（Grok×Gemini 分析統合）
# true にすると、インフルエンサーごとに「前回の導線」の逆を出す（初回は Minimal）
# QUOTE_REPOST_USE_MINIMAL_REGULAR_TEMPLATES=true

# ============================================
# 市場別設定
# ============================================
# 市場コード: EN, AR, KO, JA, ES, PT-BR
# LANG と連動する（個別指定は設定優先）
# MARKET_CODE=EN

# ============================================
# 環境設定
# ============================================
# 実行環境: development, production
NODE_ENV=production

# ============================================
# エラー追跡（オプション）
# ============================================
# Sentry などエラー追跡サービス DSN
# ERROR_TRACKING_DSN=your-error-tracking-dsn
