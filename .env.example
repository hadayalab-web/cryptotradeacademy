# ============================================
# FirstPromoter（X–FirstPromoter–Whop パイプライン）
# ============================================
# Track API 用（Whop Webhook から track/sale を送る）
# FIRSTPROMOTER_API_KEY=your-firstpromoter-api-key
# DM に載せる招待 URL のベース（未設定時は https://firstpromoter.com）
# FIRSTPROMOTER_INVITE_URL=https://firstpromoter.com
# Webhook 受信時の署名検証（FirstPromoter ダッシュボードで設定）
# FIRSTPROMOTER_WEBHOOK_SECRET=your-firstpromoter-webhook-secret

# ============================================
# アフィリエイトスカウト（DM 送信）
# ============================================
# 1 日あたりの DM 送信上限（デフォルト 15）。62 枠運用時は AFFILIATE_DM_DAILY_CAP=62
# AFFILIATE_DM_DAILY_CAP=15
# Whop のみで完結させる場合の DM 用 URL（デフォルト https://whop.com/affiliates）
# WHOP_AFFILIATE_PROGRAM_URL=https://whop.com/affiliates

# ============================================
# Affiliate Recruit Queue（EN/他地域）
# ============================================
# EN リスト取得ページ数（1実行あたり、デフォルト 1）
# EN_RECRUIT_LIST_PAGES=1
# 他地域リスト取得ページ数（1実行あたり、デフォルト 2）
# REGION_RECRUIT_LIST_PAGES=2
# EN 検索窓（分、デフォルト 90）
# EN_SEARCH_WINDOW_MIN=90
# 他地域検索窓（分、デフォルト 1440）
# REGION_SEARCH_WINDOW_MIN=1440
# EN 403 ブレーカー（15分窓、デフォルト 20）
# EN_RECRUIT_403_BREAKER=20
# EN operation_not_permitted 連続ブレーカー（デフォルト 2）
# EN_RECRUIT_OP_NOT_PERMITTED_BREAKER=2
# EN operation_not_permitted 15分窓ブレーカー（デフォルト 2）
# EN_RECRUIT_OP_NOT_PERMITTED_WINDOW_BREAKER=2
# operation_not_permitted 発生時の自動クールダウン秒数（デフォルト 2700 = 45分）
# EN_RECRUIT_OP_NOT_PERMITTED_COOLDOWN_SEC=2700
# ENで recipient403 が連続したら地域キューへフェイルオーバー（デフォルト 6、0で無効）
# EN_RECRUIT_RECIPIENT_403_FAILOVER_BREAKER=6

# ============================================
# エラー追跡（オプション）
# ============================================
# Sentry などエラー追跡サービス DSN
# ERROR_TRACKING_DSN=your-error-tracking-dsn
