# --- Seed モード用（--source seed）
# Get from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here
# Your Telegram phone (international format, e.g. +81...)
PHONE=+81xxxxxxxx
# Optional: session name (default telegram_scout_session)
# SESSION_NAME=telegram_scout_session

# --- 全自動給弾（--source api）RapidAPI
# ルート .env で python-dotenv のパースエラーが出る場合は、ここに書くと確実に読まれる
# RAPIDAPI_KEY=your_rapidapi_key
# TELEGRAM_RAPIDAPI_HOST=telegram-index.p.rapidapi.com
# 従来の名前でも可: TELEGRAM_INDEX_RAPIDAPI_KEY=your_rapidapi_key
# キーワード検索用（推奨）Telegram Search API:
# TELEGRAM_RAPIDAPI_HOST=telegram-search-api.p.rapidapi.com
# パスが違う場合のみ: TELEGRAM_RAPIDAPI_SEARCH_PATH=/実際のパス
# Telegram Index（Fetch のみの API のとき）:
# TELEGRAM_RAPIDAPI_HOST=telegram-index.p.rapidapi.com
# Telegram Data API:
# TELEGRAM_RAPIDAPI_HOST=telegram-data-api.p.rapidapi.com
