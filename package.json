{
  "name": "cryptotradeacademy",
  "version": "1.0.0",
  "description": "AI-driven Crypto Signal Bot with Whale Analysis",
  "main": "api/cron.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node scripts/monitor_process.js",
    "test:local": "node scripts/local_test.js",
    "test:email": "node scripts/test-email-delivery.js",
    "test:all-languages": "node scripts/test-all-languages-messages.js",
    "test:telegram-delivery": "node scripts/test-actual-telegram-delivery.js",
    "test:vsl1": "node scripts/test-vsl1-manual.js",
    "test:vsl2": "node scripts/test-vsl2-manual.js",
    "test:bot-command": "node scripts/test-bot-command.js",
    "test:vsl-workflow": "node scripts/test-vsl-workflow-complete.js",
    "test:value-post": "node scripts/test-value-post.js",
    "test:vsl1-reminder": "node scripts/test-vsl1-reminder.js",
    "test:vsl2-last-call": "node scripts/test-vsl2-last-call.js",
    "test:add-free-user": "node scripts/test-add-free-user.js",
    "test:buzzweave": "node scripts/test-buzzweave.js",
    "test:telegram-leads": "node scripts/test-telegram-lead-discovery.js",
    "preview:vsl1": "node scripts/preview-vsl1-message.js",
    "check:setup": "node scripts/check-vsl-workflow-setup.js",
    "check:resend": "node scripts/check-resend-setup.js",
    "check:resend:emails": "node scripts/check-resend-emails.js",
    "test:reports": "node scripts/test-lead-discovery-reports.js",
    "test:reports:execution": "node scripts/test-lead-discovery-reports.js execution",
    "test:reports:daily": "node scripts/test-lead-discovery-reports.js daily",
    "test:reports:weekly": "node scripts/test-lead-discovery-reports.js weekly",
    "test:lead-message": "node scripts/test-lead-message-delivery.js",
    "test:lead-message:send": "TEST_SEND_MESSAGES=true node scripts/test-lead-message-delivery.js",
    "test:lead-messages:sequential": "node scripts/test-all-lead-messages-sequential.js",
    "test:lead-messages:sequential:send": "TEST_SEND_MESSAGES=true node scripts/test-all-lead-messages-sequential.js",
    "verify:deployment": "node scripts/verify-vercel-deployment.js",
    "report:ceo": "node scripts/send-ceo-daily-report.js",
    "monitor": "node scripts/monitor_process.js",
    "backtest:dummy": "node scripts/backtest/eval_signals.js --input=data/signals_log_dummy.jsonl --output=data/signals_backtest_dummy.jsonl",
    "summary:dummy": "node scripts/backtest/summarize_backtest.js --input=data/signals_backtest_dummy.jsonl",
    "backtest:real": "node scripts/backtest/eval_signals.js",
    "summary:real": "node scripts/backtest/summarize_backtest.js",
    "copilot:review": "node scripts/request-copilot-review.js",
    "verify:syntax": "node scripts/verify-syntax.js",
    "build": "node scripts/copy-telegram-messages.js",
    "vercel-build": "npm run build",
    "predeploy": "node -c api/cron.js && node -c api/buzzweave-run.js && node -c services/x/client.js && node -c api/x-webhook.js",
    "vercel:logs": "node scripts/fetch-vercel-logs.js",
    "vercel:logs:safe": "node scripts/fetch-vercel-logs-safe.js",
    "vercel:analyze": "node scripts/analyze-vercel-errors.js",
    "vercel:csv": "node scripts/vercel-logs-to-csv.js",
    "vercel:issue": "node scripts/create-vercel-error-issue.js",
    "vercel:all": "npm run vercel:logs && npm run vercel:analyze && npm run vercel:csv && npm run vercel:issue",
    "validate:implementation": "node scripts/validate_implementation.js",
    "test:critical": "node scripts/test_critical_functions.js",
    "precommit": "npm run validate:implementation && npm run test:critical",
    "deploy": "vercel --prod",
    "inspect:kv": "node scripts/inspect-kv-data.js",
    "subscribe:x-webhook": "node scripts/subscribe-x-webhook.js",
    "review:quote-repost": "node scripts/request-quote-repost-review-from-grok-gemini.js",
    "thumbnail:vsl": "node scripts/generate-vsl-thumbnail-nanobanana.js",
    "thumbnail:trap-score": "node scripts/generate-thumbnail-trap-score.js",
    "thumbnail:market-trap": "node scripts/generate-thumbnail-market-trap.js",
    "compress:thumbnails": "node scripts/compress-thumbnails.js"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/kv": "^0.2.1",
    "canvas": "^3.2.1",
    "date-fns-tz": "^2.0.0",
    "dotenv": "^16.6.1",
    "lru-cache": "^10.1.0",
    "node-cron": "^3.0.0",
    "oauth-1.0a": "^2.2.6",
    "openai": "^6.9.1",
    "p-limit": "^5.0.0",
    "p-retry": "^6.0.0",
    "raw-body": "^2.5.2",
    "resend": "^6.7.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "author": "CryptoTrade Academy Team",
  "license": "ISC",
  "devDependencies": {
    "pg": "^8.18.0"
  }
}
