  "risk_analysis": {
    "risk_factors": [
      "CVRの過大評価（市場別CVRはサンプル不足だとブレが大きい）",
      "メール到達率/迷惑判定（新規ドメイン、急増送信、SPF/DKIM/DMARC未整備）",
      "LP速度・決済摩擦（モバイルでの離脱、Whop遷移の段差）",
      "トラフィック品質（X/Telegramの流入が低意図だと登録率・CVRが崩れる）",
      "プラットフォーム規約/スパム報告による配信制限（Telegram/X）",
      "市場別ローカライズ不足（翻訳品質・文化的違和感でCVR低下）",
      "返金/チャージバック（短期売上は立つがネット売上が毀損）",
      "シグナル/商品価値の体験不足（初期オンボーディングが弱いと継続率低下→LTV毀損）"
    ],
    "worst_case_scenario": {
      "definition": "メール獲得が保守的の50%（15件/日）に低下、CVRが8%まで低下、到達率問題で有効クリックがさらに-20%",
      "daily": {
        "emails": 15,
        "effective_cvr": "約6.4%",
        "conversions": 0.96,
        "revenue": "$66.24"
      },
      "monthly": {
        "revenue": "$1,987.20"
      },
      "impact": "固定費・制作工数を吸収できず、改善投資が止まりやすい（負のスパイラル）。"
    },
    "risk_mitigation": [
      "配信基盤の初日整備（SPF/DKIM/DMARC、専用サブドメイン、段階的ウォームアップ）",
      "LP/メール/Whopの計測を統一（UTM、イベント、ファネル可視化、週次でCVR分解）",
      "市場別に『勝ち市場へ集中』する資本配分ルールを設定（例: 72時間でCAC回収見込みが立つ市場に寄せる）",
      "A/Bテストを1変数に限定し高速反復（件名、ファーストビュー、CTA、価格アンカー）",
      "決済直前の不安除去（FAQ、実績、返金ポリシー、利用開始までの手順）",
      "不正確な期待値を避ける（誇大表現を抑え、コンプライアンスでBAN/返金を減らす）"
    ]
  },
