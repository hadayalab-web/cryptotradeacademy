{
  "buildCommand": "npm run build",
  "functions": {
    "api/cron.js": {
      "includeFiles": "{api/services/**,config/**,services/telegram/messages/**}"
    },
    "api/x-update-influencer-stock.js": {
      "maxDuration": 60,
      "includeFiles": "config/**"
    },
    "api/x-engagement-metrics.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/x/**}"
    },
    "api/x-webhook.js": {
      "maxDuration": 30
    },
    "api/whop-webhook.js": {
      "maxDuration": 30
    },
    "api/x-quote-repost-en.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-es.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-pt-br.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-ar.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-ja.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-ko.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/x-webhook",
      "destination": "/api/x-webhook"
    }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "*/15 * * * *" },
    { "path": "/api/vsl1-post", "schedule": "0 1,13,21 * * *" },
    { "path": "/api/x-quote-repost-en", "schedule": "0 8,12,16,20 * * *" },
    { "path": "/api/x-quote-repost-es", "schedule": "15 8,12,16,20 * * *" },
    { "path": "/api/x-quote-repost-pt-br", "schedule": "30 8,12,16,20 * * *" },
    { "path": "/api/x-quote-repost-ar", "schedule": "45 8,12,16,20 * * *" },
    { "path": "/api/x-quote-repost-ja", "schedule": "0 9,13,17,21 * * *" },
    { "path": "/api/x-quote-repost-ko", "schedule": "20 9,13,17,21 * * *" },
    { "path": "/api/vsl2-free-users", "schedule": "0 * * * *" },
    { "path": "/api/vsl1-reminder", "schedule": "0 */12 * * *" },
    { "path": "/api/vsl2-last-call", "schedule": "0 * * * *" },
    { "path": "/api/promo-stock-monitor", "schedule": "*/15 * * * *" }
  ]
}
