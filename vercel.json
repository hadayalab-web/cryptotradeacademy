{
  "buildCommand": "npm run build",
  "functions": {
    "api/cron.js": {
      "maxDuration": 300,
      "includeFiles": "{api/services/**,config/**,services/telegram/messages/**}"
    },
    "api/kiba-5min.js": {
      "maxDuration": 300
    },
    "api/x-engagement-metrics.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/x/**}"
    },
    "api/x-webhook.js": {
      "maxDuration": 30
    },
    "api/warriorplus-ipn.js": {
      "maxDuration": 30
    },
    "api/whop-webhook.js": {
      "maxDuration": 30
    },
    "api/affiliate-recruit-en-send.js": {
      "maxDuration": 300
    },
    "api/affiliate-recruit-en-list.js": {
      "maxDuration": 300
    },
    "api/affiliate-recruit-regions-list.js": {
      "maxDuration": 300
    },
    "api/affiliate-recruit-queue.js": {
      "maxDuration": 30
    },
    "api/affiliate-recruit-bookmark.js": {
      "maxDuration": 300
    },
    "api/x-reply-sales-run.js": {
      "maxDuration": 300
    },
    "api/x-reply-sales-list.js": {
      "maxDuration": 300
    },
    "api/x-reply-sales-list-rotate.js": {
      "maxDuration": 300
    },
    "api/x-reply-sales-click.js": {
      "maxDuration": 30
    },
    "api/x-reply-sales-kpi.js": {
      "maxDuration": 60
    },
    "api/x-reply-sales-list-history.js": {
      "maxDuration": 30
    },
    "api/x-reply-sales-followup.js": {
      "maxDuration": 60
    },
    "api/x-post-minimal.js": {
      "maxDuration": 600,
      "includeFiles": "{config/**,services/x/**,services/telegram/messages/**}"
    },
    "api/x-post-regular-teaser.js": {
      "maxDuration": 600,
      "includeFiles": "{config/**,services/x/**,services/telegram/messages/**,services/social/**}"
    },
    "api/telegram-scout-mark-sent.js": {
      "maxDuration": 10
    },
    "api/telegram-scout-refill.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/root"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard/index.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/public/dashboard/index.html"
    },
    {
      "source": "/dashboard/index.html",
      "destination": "/public/dashboard/index.html"
    },
    {
      "source": "/api/x-webhook",
      "destination": "/api/x-webhook"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/minimal-tg-delivery",
      "schedule": "8 0,6,12,18 * * *"
    },
    {
      "path": "/api/minimal-upsell-promo",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/minimal-upsell-promo",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/kiba-5min",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/x-post-minimal",
      "schedule": "8 0,6,12,18 * * *"
    },
    {
      "path": "/api/x-post-regular-teaser",
      "schedule": "23 0,6,12,18 * * *"
    },
    {
      "path": "/api/daily-admin-report",
      "schedule": "0 1 * * *"
    }
  ]
}
