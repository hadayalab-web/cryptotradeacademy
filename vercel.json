{
  "buildCommand": "npm run build",
  "functions": {
    "api/cron.js": {
      "maxDuration": 300,
      "includeFiles": "{api/services/**,config/**,services/telegram/messages/**}"
    },
    "api/x-update-influencer-stock.js": {
      "maxDuration": 60,
      "includeFiles": "config/**"
    },
    "api/x-engagement-metrics.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/x/**}"
    },
    "api/x-webhook.js": {
      "maxDuration": 30
    },
    "api/whop-webhook.js": {
      "maxDuration": 30
    },
    "api/x-quote-repost-en.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-es.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-pt-br.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-ar.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-ja.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/x-quote-repost-ko.js": {
      "maxDuration": 60,
      "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}"
    },
    "api/minimal-tg-delivery.js": {
      "maxDuration": 120,
      "includeFiles": "{config/**,services/telegram/**,services/integrated/**,utils/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/x-webhook",
      "destination": "/api/x-webhook"
    }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0,7,22,37,52 * * * *" },
    { "path": "/api/minimal-tg-delivery", "schedule": "10 0,6,12,18 * * *" },
    { "path": "/api/x-quote-repost-en", "schedule": "4 * * * *" },
    { "path": "/api/x-quote-repost-es", "schedule": "9 * * * *" },
    { "path": "/api/x-quote-repost-pt-br", "schedule": "14 * * * *" },
    { "path": "/api/x-quote-repost-ar", "schedule": "19 * * * *" },
    { "path": "/api/x-quote-repost-ja", "schedule": "24 * * * *" },
    { "path": "/api/x-quote-repost-ko", "schedule": "29 * * * *" }
  ]
}
