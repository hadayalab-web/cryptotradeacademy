{
  "buildCommand": "npm run build",
  "functions": {
    "api/cron.js": { "maxDuration": 300, "includeFiles": "{api/services/**,config/**,services/telegram/messages/**}" },
    "api/cron-minimal.js": { "maxDuration": 300, "includeFiles": "{api/services/**,config/**,services/telegram/messages/**}" },
    "api/cron-regular.js": { "maxDuration": 300, "includeFiles": "{api/services/**,config/**,services/telegram/messages/**}" },
    "api/x-update-influencer-stock.js": { "maxDuration": 60, "includeFiles": "config/**" },
    "api/x-engagement-metrics.js": { "maxDuration": 60, "includeFiles": "{config/**,services/x/**}" },
    "api/x-webhook.js": { "maxDuration": 30 },
    "api/whop-webhook.js": { "maxDuration": 30 },
    "api/x-quote-repost-en.js": { "maxDuration": 120, "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}" },
    "api/x-quote-repost-es.js": { "maxDuration": 120, "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}" },
    "api/x-quote-repost-pt-br.js": { "maxDuration": 120, "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}" },
    "api/x-quote-repost-ar.js": { "maxDuration": 120, "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}" },
    "api/x-quote-repost-ja.js": { "maxDuration": 120, "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}" },
    "api/x-quote-repost-ko.js": { "maxDuration": 120, "includeFiles": "{config/**,services/**,api/x-quote-repost.js,utils/**}" }
  },
  "rewrites": [{ "source": "/api/x-webhook", "destination": "/api/x-webhook" }],
  "crons": [
    { "path": "/api/cron", "schedule": "*/15 * * * *" },
    { "path": "/api/cron-regular", "schedule": "0 0,6,12,18 * * *" },
    { "path": "/api/cron-minimal", "schedule": "10 0,6,12,18 * * *" },
    { "path": "/api/minimal-upsell-promo", "schedule": "0 8 * * *" },
    { "path": "/api/minimal-upsell-promo", "schedule": "0 20 * * *" },
    { "path": "/api/affiliate-recruit-en", "schedule": "0 0,3,6,9,12,15,18,21 * * *" },
    { "path": "/api/affiliate-recruit-regions", "schedule": "0 12,17,21 * * *" },
    { "path": "/api/kiba-5min", "schedule": "*/5 * * * *" },
    { "path": "/api/cron-premium-alerts", "schedule": "*/5 * * * *" }
  ]
}
